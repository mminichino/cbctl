{
  "apiVersion": "cbctl/v1",
  "clusters": [
    {
      "availability": {
        "type": "single"
      },
      "buckets": [
        {
          "memoryAllocationInMb": 256,
          "name": "playground"
        }
      ],
      "cloudProvider": {
        "cidr": "10.30.0.0/24",
        "region": "eastus",
        "type": "azure"
      },
      "configurationType": "singleNode",
      "hibernation": {
        "timezone": "US/Eastern",
        "weekdays": true,
        "weekend": false
      },
      "name": "one",
      "serviceGroups": [
        {
          "node": {
            "compute": {
              "cpu": 4,
              "ram": 16
            },
            "disk": {
              "type": "P6"
            }
          },
          "numOfNodes": 1,
          "services": [
            "data",
            "index",
            "query",
            "search"
          ]
        }
      ],
      "support": {
        "plan": "basic"
      }
    }
  ],
  "project": {
    "name": "sandbox"
  }
}
