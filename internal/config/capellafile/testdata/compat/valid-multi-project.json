{
  "apiVersion": "cbctl/v1",
  "credentialsOutput": "./secrets-out",
  "organizationId": "${CAPELLA_ORG_ID}",
  "projects": [
    {
      "clusters": [
        {
          "availability": {
            "type": "multi"
          },
          "buckets": [
            {
              "memoryAllocationInMb": 512,
              "name": "orders",
              "scopes": [
                {
                  "collections": [
                    {
                      "name": "items"
                    }
                  ],
                  "name": "inventory"
                }
              ]
            }
          ],
          "cloudProvider": {
